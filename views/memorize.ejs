<!DOCTYPE html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="container">
      <h1><%= title %></h1>

      <section class="home-section" aria-labelledby="custom-select-heading">
        <details id="customSelectPanel" class="dropdown-panel">
          <summary id="custom-select-heading" class="dropdown-summary">
            自選背誦章節
          </summary>
          <div class="dropdown-body">
            <div class="control-grid">
              <div class="field">
                <label for="books">書卷</label>
                <select id="books" name="books">
                  <option value="">請選擇書卷</option>
                  <% books.forEach((book) => { %>
                    <option value="<%= book %>" <%= book === defaultBook ? 'selected' : '' %>><%= book %></option>
                  <% }) %>
                </select>
              </div>

              <div class="field">
                <label for="chapter">章</label>
                <select id="chapter" name="chapter">
                  <option value="">請選擇章</option>
                </select>
              </div>

              <div class="field">
                <label for="verse">節（可選）</label>
                <select id="verse" name="verse">
                  <option value="">請選擇節</option>
                </select>
              </div>
            </div>

            <div class="field mode-field">
              <span class="mode-label">練習模式</span>
              <div class="mode-toggle" role="radiogroup" aria-label="練習模式">
                <label class="mode-option">
                  <input type="radio" name="quizMode" value="blank" <%= defaultMode === 'blank' ? 'checked' : '' %> />
                  <span>填空格</span>
                </label>
                <label class="mode-option">
                  <input type="radio" name="quizMode" value="choice" <%= defaultMode === 'choice' ? 'checked' : '' %> />
                  <span>選擇題（3 選 1）</span>
                </label>
              </div>
            </div>

            <div class="field mode-field density-field">
              <span class="mode-label">空格密度</span>
              <div class="mode-toggle" role="radiogroup" aria-label="空格密度">
                <label class="mode-option">
                  <input type="radio" name="blankDensity" value="low" <%= defaultDensity === 'low' ? 'checked' : '' %> />
                  <span>少（較易）</span>
                </label>
                <label class="mode-option">
                  <input type="radio" name="blankDensity" value="medium" <%= defaultDensity === 'medium' ? 'checked' : '' %> />
                  <span>中</span>
                </label>
                <label class="mode-option">
                  <input type="radio" name="blankDensity" value="high" <%= defaultDensity === 'high' ? 'checked' : '' %> />
                  <span>多（較難）</span>
                </label>
              </div>
              <p class="hint-text density-hint">較長經文會自動產生較多空格；選「多」會更有挑戰。</p>
            </div>

            <p id="memorizeMessage" class="form-message">
              展開後可自選書卷、章與節。不選節時會練習整章。
            </p>
            <div class="button-row panel-actions">
              <button id="startMemorizeBtn" type="button">開始背誦</button>
              <button id="retryMaskBtn" type="button" class="hidden">重新出題</button>
            </div>
          </div>
        </details>
      </section>

      <section class="home-section review-section">
        <a class="secondary-button review-button" href="/review">溫習聖經</a>
        <p class="hint-text">前往閱讀原文經文。</p>
      </section>

      <section class="home-section quiz-demo-section">
        <p id="quizMessage" class="form-message quiz-message hidden" aria-live="polite"></p>
        <section id="memorizeResult" class="scripture-result" aria-live="polite"></section>
        <section id="gradingResult" class="grading-result hidden" aria-live="polite"></section>
        <div class="button-row quiz-actions">
          <button id="submitAnswersBtn" type="button" class="hidden">提交答案</button>
          <button id="prevVerseBtn" type="button" class="hidden">上一節</button>
          <button id="nextVerseBtn" type="button" class="hidden">下一節</button>
        </div>
      </section>
    </div>

    <script>
      window.bibleIndex = <%- JSON.stringify(bibleIndex) %>;
      window.memorizeDefaults = <%- JSON.stringify({
        defaultBook,
        defaultChapter,
        defaultVerse,
        defaultMode,
        defaultDensity,
        autoStart
      }) %>;
    </script>
    <script src="/js/memorize.js"></script>
  </body>
</html>
