<!DOCTYPE html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="container">
      <h1><%= title %></h1>
      <div class="button-row">
        <a class="secondary-button" href="/review">溫習聖經</a>
      </div>
      <p><%= message %></p>

      <div class="control-grid">
        <div class="field">
          <label for="books">書卷</label>
          <select id="books" name="books">
            <option value="">請選擇書卷</option>
            <% books.forEach((book) => { %>
              <option value="<%= book %>" <%= book === defaultBook ? 'selected' : '' %>><%= book %></option>
            <% }) %>
          </select>
        </div>

        <div class="field">
          <label for="chapter">章</label>
          <select id="chapter" name="chapter">
            <option value="">請選擇章</option>
          </select>
        </div>

        <div class="field">
          <label for="verse">節（可選）</label>
          <select id="verse" name="verse">
            <option value="">請選擇節</option>
          </select>
        </div>
      </div>

      <div class="field mode-field">
        <span class="mode-label">練習模式</span>
        <div class="mode-toggle" role="radiogroup" aria-label="練習模式">
          <label class="mode-option">
            <input type="radio" name="quizMode" value="blank" <%= defaultMode === 'blank' ? 'checked' : '' %> />
            <span>填空格</span>
          </label>
          <label class="mode-option">
            <input type="radio" name="quizMode" value="choice" <%= defaultMode === 'choice' ? 'checked' : '' %> />
            <span>選擇題（3 選 1）</span>
          </label>
        </div>
      </div>

      <p id="memorizeMessage" class="form-message">
        請先選擇書卷與章，節可不選。不選節時會顯示整章練習。
      </p>
      <button id="startMemorizeBtn" type="button">開始背誦</button>
      <button id="retryMaskBtn" type="button" class="hidden">同節重新出題</button>

      <section id="quizProgress" class="quiz-progress hidden" aria-live="polite"></section>
      <section id="memorizeResult" class="scripture-result" aria-live="polite"></section>
      <section id="gradingResult" class="grading-result" aria-live="polite"></section>
    </div>

    <script>
      window.bibleIndex = <%- JSON.stringify(bibleIndex) %>;
      window.memorizeDefaults = <%- JSON.stringify({ defaultBook, defaultChapter, defaultMode, autoStart }) %>;
    </script>
    <script src="/js/memorize.js"></script>
  </body>
</html>
